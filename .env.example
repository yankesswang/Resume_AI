# Resume AI — environment configuration
#
# Copy to .env and edit. Precedence: real environment variable > .env > default.
# A value already exported by systemd/docker always wins over this file, so a
# stale .env in the working copy cannot override a deployed setting.
# Point ENV_FILE at another path to load a different file.
#
# Every value below is optional; the defaults shown reproduce the historical
# local-development behaviour.

# =============================================================================
# Storage
# =============================================================================
# SQLite database. Holds full applicant PII — back it up and keep it off any
# world-readable volume.
DB_PATH=./resume_ai.db
# Where uploaded PDFs are written.
DATA_DIR=./data
# Where parsed markdown/images are written.
OUTPUT_DIR=./output
# Root the /output photo route serves from. Only image files beneath an
# output*/ subdirectory are served. Defaults to the project root for backwards
# compatibility with existing batch layouts; in production point it at a
# dedicated directory so the served root holds nothing but photos.
PHOTO_ROOT=.
# Job requirement JSON loaded at startup.
JOB_REQUIREMENT_PATH=./job_requirement.json

# =============================================================================
# Authentication
# =============================================================================
# !!! WARNING !!!
# AUTH_ENABLED=false (the default) leaves EVERY endpoint unauthenticated.
# Anyone who can reach this port can read, export, and delete the full resume
# database — names, mobiles, emails, addresses, birth years and photos of
# thousands of real applicants. It is a safe default ONLY for a server bound to
# localhost. Set AUTH_ENABLED=true before binding to any public interface.
AUTH_ENABLED=false
# Comma-separated full-access keys (may read and mutate).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Comma-separated read-only keys: may GET, rejected with 403 on write verbs.
READONLY_API_KEYS=
# Header carrying the key. "Authorization: Bearer <key>" is also accepted, for
# proxies that strip custom headers.
AUTH_HEADER=X-API-Key
# Startup fails when AUTH_ENABLED=true and no key of either class is set.

# =============================================================================
# User accounts and sessions
# =============================================================================
# API keys are for unattended callers (scripts, the worker, CI). People log in
# with an account instead, so access is attributable to a named employee and
# can be revoked for one person.
#
# Signing key for login tokens. REQUIRED when AUTH_ENABLED=true.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everybody out. Keep it identical across processes, or a
# token minted by one will be rejected by the next.
SESSION_SECRET=
# How long a login lasts. 12h = one working day.
SESSION_TTL_SECONDS=43200
# Whether strangers may submit a registration. A registered account is
# `pending` and can see nothing until root approves it, so leaving this on
# costs only a row in a table.
REGISTRATION_OPEN=true
# Optional comma-separated allow-list of email domains that may register.
# Empty means any domain.
REGISTRATION_DOMAINS=
#
# Create the first root account (nobody exists to approve it, so it is made
# from the machine holding the DB):
#   python -m app.accounts_cli bootstrap-root --email you@company.com

# =============================================================================
# CORS
# =============================================================================
# Comma-separated allowed browser origins. "*" is rejected at startup when
# AUTH_ENABLED=true — list the exact frontend origins instead.
CORS_ORIGINS=*

# =============================================================================
# Uploads
# =============================================================================
# Max accepted upload size in bytes (default 200 MB). Exceeding it returns 413.
# 200MB because 104 resumes are multi-page colour scans: measured over the 84
# PDFs in this repo the median is 131MB and the largest 162MB, so the usual
# 25MB cap would reject ~99% of real uploads. Behind nginx, raise
# client_max_body_size to match — the lower of the two wins.
MAX_UPLOAD_BYTES=209715200
# Max pages for a SINGLE-resume upload. The 104 batch exports in data/ are
# 595-746 pages holding ~200 candidates each; /api/upload stores whatever it
# parses as ONE candidate, so such a bundle would merge hundreds of people into
# a single row (and Marker would load it all into RAM). Size cannot tell them
# apart - a real resume is already 131-162MB - so pages are the discriminator.
# Import bundles with: scripts/batch_import.py <pdf> --parser-backend plumber
MAX_UPLOAD_PAGES=40
# Uploads allowed per window, per API key (or per client IP when auth is off).
# Exceeding it returns 429. Enforced per process: behind N uvicorn workers the
# effective limit is N x this value, so use Redis if you scale out.
UPLOAD_RATE_LIMIT=30
# Rate-limit window in seconds.
UPLOAD_RATE_WINDOW=60

# =============================================================================
# PDF parsing
# =============================================================================
# Offload PDF->Markdown parsing to a GPU worker, e.g. http://192.168.1.100:8100
# Empty means parse locally. When set, PARSER_BACKEND is ignored.
WORKER_URL=
# Local parser: "marker" (GPU + OCR, handles scanned PDFs) or "plumber" (pure
# Python, text layer only — raises on scanned PDFs).
PARSER_BACKEND=marker

# =============================================================================
# LLM (LM Studio / OpenAI)
# =============================================================================
# These are the *environment* layer. The provider, model and credentials are
# normally set from the UI at /llm-settings, which stores them in the database.
# Anything set here OVERRIDES the UI and is shown read-only there, so leave a
# variable commented out unless this deployment must pin it.
# 服務網址與模型改由 /llm-settings 設定（存進資料庫），這裡不再釘住，
# 否則 UI 上的「服務網址」會變成唯讀。正式部署若要強制指定，取消註解即可。
# LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
# 以下 LLM 欄位全部改由 /llm-settings 設定，存在 app_settings.llm_config。
# 在這裡設值會蓋過 DB 並讓 UI 欄位變唯讀（見 llm_config._ENV_MAP）；
# 正式部署若要強制指定，取消註解即可。
# LM_STUDIO_MODEL=
# MODEL_CONTEXT_LENGTH 必須對得上 LM Studio 實際設定，太低會靜默截斷履歷、
# 毀掉評分 —— 改用 /llm-settings 調整時同樣要注意這點。
# MODEL_CONTEXT_LENGTH=32768
# RESPONSE_TOKENS=2048
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# 這個沒有 UI 對應，仍由環境變數控制：送進 AI 分級器的履歷字數。
TIER_MARKDOWN_CHARS=12000

# Used by whichever section (chat / embedding) is set to the OpenAI provider
# and has no key stored from the UI. Set it here to keep the credential out of
# the database entirely.
# OPENAI_API_KEY=

# =============================================================================
# Scoring
# =============================================================================
# Runtime scoring overrides written by the /scoring page. Absent = built-in
# defaults from app/scoring/config.py.
SCORING_CONFIG_PATH=./scoring_config.json

# =============================================================================
# Jobs / worker
# =============================================================================
# Seconds between background job polls.
JOB_POLL_INTERVAL=2
# Concurrent background jobs.
JOB_CONCURRENCY=1

# =============================================================================
# Data retention & auditing (PII)
# =============================================================================
# Days to keep data before automatic purging. 0 disables purging.
RETENTION_DAYS=0
# Record who accessed which candidate, into the access_audit table. Leave on:
# it is what answers "who looked at this applicant's resume?" after the fact.
AUDIT_ENABLED=true
